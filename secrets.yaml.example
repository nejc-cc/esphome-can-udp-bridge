# Copy to secrets.yaml in your ESPHome config directory and fill in.
# secrets.yaml must never be committed.

# --- network (shared by all devices) ---
gateway: "192.0.2.1"
subnet: "255.255.255.0"
dns1: "192.0.2.1"

# --- per-tunnel static IPs ---
# Reserve these in your DHCP server so nothing else can take them.
ip_sfcantunnel1: "192.0.2.11"
ip_sfcantunnel2: "192.0.2.12"
ip_sfcantunnel3: "192.0.2.13"

# --- ESPHome API encryption keys ---
# Generate one per device, e.g.:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
sfcantunnel1__encryption_key: "REPLACE_WITH_YOUR_OWN_32_BYTE_BASE64_KEY"
sfcantunnel2__encryption_key: "REPLACE_WITH_YOUR_OWN_32_BYTE_BASE64_KEY"
sfcantunnel3__encryption_key: "REPLACE_WITH_YOUR_OWN_32_BYTE_BASE64_KEY"

# --- OTA and web server ---
otapass: "REPLACE_ME"
webuser: "admin"
webpass: "REPLACE_ME"
